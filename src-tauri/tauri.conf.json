{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "rclone Easy Migration",
  "version": "0.1.0",
  "identifier": "io.github.rclone-easy-migration",
  "build": {
    "frontendDist": "../ui"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [
      {
        "label": "main",
        "title": "rclone Easy Migration",
        "width": 1200,
        "height": 850,
        "minWidth": 380,
        "minHeight": 600,
        "center": true,
        "resizable": true
      }
    ],
    "security": {
      "csp": "default-src 'self'; script-src 'self'; style-src 'self' 'unsafe-inline'; font-src 'self' data:; img-src 'self' data: blob:; connect-src 'self' ipc: http://ipc.localhost http://127.0.0.1:*"
    }
  },
  "bundle": {
    "active": true,
    "targets": ["app", "appimage"],
    "category": "Utility",
    "shortDescription": "Easy cloud-to-cloud migration powered by rclone",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "windows": {
      "nsis": { "installMode": "currentUser" }
    }
  }
}
